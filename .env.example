# Application
APP_ENV=local
TZ=Asia/Jakarta

# Google Cloud - configure later
GCP_PROJECT_ID=
GCP_REGION=asia-southeast2
BQ_DATASET_RAW=raw_name
BQ_DATASET_ANALYTICS=dataset_name

# Airflow
AIRFLOW__SMTP__SMTP_HOST=smtp.gmail.com
AIRFLOW__SMTP__SMTP_STARTTLS=True
AIRFLOW__SMTP__SMTP_SSL=False
AIRFLOW__SMTP__SMTP_USER=example@mail.com
AIRFLOW__SMTP__SMTP_PASSWORD=app_password
AIRFLOW__SMTP__SMTP_PORT=your_port
AIRFLOW__SMTP__SMTP_MAIL_FROM=example@mail.com
AIRFLOW_UID=your_UID
AIRFLOW_DB_NAME=your_airflow_db_name
AIRFLOW_DB_USER=your_airflow_user
AIRFLOW_DB_PASSWORD=your_airflow_password
AIRFLOW__API_AUTH__JWT_SECRET = paste_your_generated_secret_here

# Market data
YAHOO_TICKER=^JKSE

# Optional API credentials - configure when needed
BPS_API_KEY=
GDELT_ENABLED=false

#PostgreSQL
POSTGRES_DB=your_postgres_db
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password

